# Database - use pooled Neon URL for app runtime
DATABASE_URL=your_database_url_here

# Authentication
JWT_SECRET=your-secret-key-change-in-production
SESSION_SECRET=your-32-plus-character-session-secret-here

# SendGrid Email Configuration
# Pilot launch default is disabled. Set ENABLE_EMAIL_DELIVERY=true only after SendGrid is configured.
ENABLE_EMAIL_DELIVERY=false
SENDGRID_API_KEY=
FROM_EMAIL=noreply@nurseprep.app
FROM_NAME=NursePrep Analytics

# Optional AI services
# Content Mapper and Lesson Builder work with deterministic fallback when this is blank.
# Set this server-side only when live AI generation should be enabled.
OPENAI_API_KEY=

# Optional OpenAI TTS asset verification
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Application
APP_URL=http://localhost:5000
NODE_ENV=development

# Optional: Additional configurations
PORT=5000

# Harrity Lesson Builder agent-assisted generation
# Audited MVP default: Nursing Curriculum Builder Agent.
NURSING_CURRICULUM_AGENT_ID=agt_69f192d4f1908191baa41586bb0df9ea
# Set endpoint after enabling the selected workspace agent API channel.
NURSING_CURRICULUM_AGENT_ENDPOINT=
# Backward-compatible alias used by older local launch scripts.
HARRITY_LESSON_AGENT_ENDPOINT=
# Server-side only. If unset, OPENAI_API_KEY is used for direct OpenAI fallback when available.
NURSING_CURRICULUM_AGENT_API_KEY=
# Optional direct OpenAI fallback when the Workspace Agent API channel is unavailable.
NURSING_CURRICULUM_AGENT_MODEL=gpt-4o-mini
