{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NursingCrosswalkJobManifest",
  "type": "object",
  "required": ["workflow_name", "objective", "stage_order", "jobs"],
  "properties": {
    "workflow_name": {"type": "string"},
    "objective": {"type": "string"},
    "deliverables": {"type": "array", "items": {"type": "string"}},
    "source_priority": {"type": "array", "items": {"type": "string"}},
    "blocking_rules": {"type": "array", "items": {"type": "string"}},
    "stage_order": {"type": "array", "items": {"type": "string"}},
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["job_id", "stage", "title"],
        "properties": {
          "job_id": {"type": "string"},
          "stage": {"type": "string"},
          "title": {"type": "string"},
          "objective": {"type": "string"},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "prompt_key": {"type": "string"},
          "validation_checks": {"type": "array", "items": {"type": "string"}},
          "allow_blocked": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
