{
  "workflow_name": "nursing-crosswalk-release-refinement",
  "objective": "refine an existing integrated workbook into a release-ready edition",
  "deliverables": ["Master_Release", "Final_Topic_Master", "Final_Solution_Crosswalk", "Release_Review_Queue"],
  "source_priority": ["existing integrated workbook", "governance workbooks", "connected internal workbook references"],
  "blocking_rules": ["keep editorial merges conservative", "do not hide unresolved ambiguity"],
  "stage_order": ["intake", "inventory", "governance", "master", "coverage", "release", "qa"],
  "jobs": [
    {"job_id": "J00-intake", "stage": "intake", "title": "define release objective"},
    {"job_id": "J10-inventory", "stage": "inventory", "title": "inventory existing integrated workbook", "depends_on": ["J00-intake"]},
    {"job_id": "J20-governance", "stage": "governance", "title": "apply conservative editorial merges", "depends_on": ["J10-inventory"]},
    {"job_id": "J30-master", "stage": "master", "title": "write release master tables", "depends_on": ["J20-governance"]},
    {"job_id": "J40-coverage", "stage": "coverage", "title": "rebuild coverage and release review queue", "depends_on": ["J30-master"]},
    {"job_id": "J50-release", "stage": "release", "title": "assemble release workbook", "depends_on": ["J40-coverage"]},
    {"job_id": "J60-qa", "stage": "qa", "title": "validate release workbook", "depends_on": ["J50-release"]}
  ]
}
